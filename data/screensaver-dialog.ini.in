[Power]
#是否提供关机选项
can-poweroff=@CAN_POWER_OFF@

#是否提供重启选项
can-reboot=@CAN_REBOOT@

#是否提供挂起选项
can-suspend=@CAN_SUSPEND@

[Common]
#解锁界面是否显示FullName
show-fullname=@SHOW_FULLNAME@

#是否显示人脸的摄像头预览（默认关闭）
face-preview-enabled=false

#锁屏是否自动启动认证
#true（默认）：锁屏后自动 startAuthUser，显示密码输入框
#false：不自动起认证，仅显示「重新认证」按钮，由用户手动触发
auto-start-auth=true
